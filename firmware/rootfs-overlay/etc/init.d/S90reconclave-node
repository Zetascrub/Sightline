#!/bin/sh

DAEMON=/usr/bin/reconclave-k230-node
PIDFILE=/var/run/reconclave-k230-node.pid
LOGFILE=/var/log/reconclave-k230-node.log

start() {
	printf 'Starting Reconclave node: '
	mkdir -p /root/reconclave/evidence /root/reconclave/trust /var/run/reconclave /var/log
	chmod 700 /root/reconclave /root/reconclave/trust
	# -O, not a plain shell redirect: start-stop-daemon -b backgrounds and
	# detaches the daemon's own stdio, so a `>>"$LOGFILE" 2>&1` wrapped
	# around this line only ever captured start-stop-daemon's own output,
	# never the daemon's - LOGFILE was silently empty in production
	# regardless of what the daemon printed. -O makes start-stop-daemon
	# itself append the daemon's stdout/stderr to LOGFILE.
	start-stop-daemon -S -b -m -p "$PIDFILE" -O "$LOGFILE" -x "$DAEMON"
	echo OK
}

stop() {
	printf 'Stopping Reconclave node: '
	start-stop-daemon -K -p "$PIDFILE" -x "$DAEMON" 2>/dev/null || true
	rm -f "$PIDFILE"
	echo OK
}

case "${1:-}" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
