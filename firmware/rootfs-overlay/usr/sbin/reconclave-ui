#!/bin/sh
set -eu

command=${1:-}
item=${2:-}
case "$command" in
    screen)
        case "$item" in
            home|tools|network|wifi-survey|wifi-setup|recon|assets|findings|nmap|packet|evidence|vision|location|session|node|device|settings) ;;
            *) echo "Unknown screen: $item" >&2; exit 2 ;;
        esac
        request="screen $item" ;;
    asset)
        case "$item" in
            ''|*[!0-9.]*) echo "Usage: reconclave-ui asset IPv4" >&2; exit 2 ;;
        esac
        request="assets open $item" ;;
    *)
        echo "Usage: reconclave-ui screen SCREEN | asset IPv4" >&2
        echo "Screens: home tools network wifi-survey wifi-setup assets findings nmap packet evidence vision location session node device settings" >&2
        exit 2 ;;
esac

directory=/run/reconclave
mkdir -p "$directory"
umask 077
temporary="$directory/.ui-command.$$"
trap 'rm -f "$temporary"' EXIT INT TERM
printf '%s\n' "$request" >"$temporary"
mv "$temporary" "$directory/ui-command"
trap - EXIT INT TERM
echo "Queued: $request"
