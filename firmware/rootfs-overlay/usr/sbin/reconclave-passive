#!/usr/bin/env python3
"""Receive-only LAN sample: report observed hosts without inferring open ports."""
import ipaddress
import json
import os
from pathlib import Path
import re
import signal
import struct
import subprocess
import sys
import time

active = None
cancelled = False


def stop(_signum, _frame):
    global cancelled
    cancelled = True
    if active is not None:
        active.terminate()


signal.signal(signal.SIGINT, stop)
signal.signal(signal.SIGTERM, stop)


def select_interface(scope, requested):
    if requested not in ("", "eth0", "wlan0"):
        raise ValueError("Interface must be eth0 or wlan0")
    if not requested:
        destination = str(next(scope.hosts(), scope.network_address))
        route = subprocess.run(["ip", "route", "get", destination], capture_output=True, text=True, check=True)
        fields = route.stdout.split()
        if "dev" not in fields or fields.index("dev") + 1 >= len(fields):
            raise ValueError("No route to attached scope")
        requested = fields[fields.index("dev") + 1]
        if requested not in ("eth0", "wlan0"):
            raise ValueError("Route does not use Ethernet or Wi-Fi")
    addresses = subprocess.run(["ip", "-o", "-4", "addr", "show", "dev", requested],
                               capture_output=True, text=True, check=True).stdout
    for line in addresses.splitlines():
        fields = line.split()
        if len(fields) >= 4 and fields[2] == "inet":
            local = ipaddress.ip_interface(fields[3])
            if scope.subnet_of(local.network):
                return requested, local.ip
    raise ValueError("Scope is not attached to the selected interface")


def mac_text(raw):
    return ":".join(f"{value:02x}" for value in raw)


def local_addresses():
    output = subprocess.run(["ip", "-o", "-4", "addr", "show"], capture_output=True,
                            text=True, check=True).stdout
    addresses = set()
    for line in output.splitlines():
        fields = line.split()
        if len(fields) >= 4 and fields[2] == "inet":
            addresses.add(ipaddress.ip_interface(fields[3]).ip)
    return addresses


def dns_query_name(payload, nbns=False):
    if len(payload) < 17:
        return ""
    offset = 12
    labels = []
    for _ in range(12):
        if offset >= len(payload):
            return ""
        size = payload[offset]
        offset += 1
        if size == 0:
            break
        if size & 0xC0 or size > 63 or offset + size > len(payload):
            return ""
        label = payload[offset:offset + size]
        offset += size
        if nbns and size == 32 and all(65 <= value <= 80 for value in label):
            label = bytes(((label[i] - 65) << 4) | (label[i + 1] - 65) for i in range(0, 32, 2)).rstrip(b" \0")
        cleaned = re.sub(r"[^A-Za-z0-9_.-]", "", label.decode("ascii", "ignore"))[:63]
        if cleaned:
            labels.append(cleaned)
    return ".".join(labels)[:120]


def dhcp_details(payload):
    if len(payload) < 240 or payload[236:240] != b"\x63\x82\x53\x63":
        return "", None
    name = ""
    requested = None
    offset = 240
    while offset < len(payload):
        code = payload[offset]
        offset += 1
        if code == 255:
            break
        if code == 0:
            continue
        if offset >= len(payload) or offset + 1 + payload[offset] > len(payload):
            break
        length = payload[offset]
        value = payload[offset + 1:offset + 1 + length]
        offset += 1 + length
        if code == 12:
            name = re.sub(r"[^A-Za-z0-9_.-]", "", value.decode("ascii", "ignore"))[:80]
        elif code == 50 and length == 4:
            requested = ipaddress.IPv4Address(value)
    return name, requested


def read_pcap(path, scope, own_ips):
    data = path.read_bytes()
    if len(data) < 24 or len(data) > 4 * 1024 * 1024:
        raise ValueError("Capture is empty or exceeds its 4 MiB limit")
    endian = {b"\xd4\xc3\xb2\xa1": "<", b"\xa1\xb2\xc3\xd4": ">",
              b"\x4d\x3c\xb2\xa1": "<", b"\xa1\xb2\x3c\x4d": ">"}.get(data[:4])
    if not endian or struct.unpack_from(endian + "I", data, 20)[0] != 1:
        raise ValueError("Expected Ethernet PCAP")
    hosts = {}
    packets = 0
    offset = 24

    def observe(address_bytes, source_mac, signal_name):
        address = ipaddress.IPv4Address(address_bytes)
        if address not in scope or address in own_ips or address.is_unspecified or address.is_multicast:
            return
        if source_mac == b"\0" * 6 or source_mac[0] & 1:
            return
        record = hosts.setdefault(str(address), {"address": str(address), "mac": mac_text(source_mac),
                                                     "signals": set(), "protocols": set(), "names": set(),
                                                     "packets": 0})
        record["signals"].add(signal_name)
        record["packets"] += 1
        return record

    while offset + 16 <= len(data) and packets < 5000:
        captured = struct.unpack_from(endian + "I", data, offset + 8)[0]
        offset += 16
        if captured > 2048 or offset + captured > len(data):
            raise ValueError("Truncated or oversized PCAP packet")
        frame = data[offset:offset + captured]
        offset += captured
        packets += 1
        if len(frame) < 14:
            continue
        source_mac = frame[6:12]
        ether_type = int.from_bytes(frame[12:14], "big")
        start = 14
        if ether_type in (0x8100, 0x88a8) and len(frame) >= 18:
            ether_type = int.from_bytes(frame[16:18], "big")
            start = 18
        if ether_type == 0x0806 and len(frame) >= start + 28:
            arp = frame[start:]
            if arp[:6] == b"\0\x01\x08\0\x06\x04":
                observe(arp[14:18], arp[8:14], "arp")
        elif ether_type == 0x0800 and len(frame) >= start + 20:
            ipv4 = frame[start:]
            if ipv4[0] >> 4 == 4 and (ipv4[0] & 15) >= 5:
                header = (ipv4[0] & 15) * 4
                total = int.from_bytes(ipv4[2:4], "big")
                broadcast = bool(frame[0] & 1)
                packet = ipv4[:min(len(ipv4), total)] if total >= header else ipv4
                udp = None
                ports = (0, 0)
                if (ipv4[9] == 17 and len(packet) >= header + 8 and
                        int.from_bytes(ipv4[6:8], "big") & 0x1fff == 0):
                    ports = struct.unpack_from("!HH", packet, header)
                    length = int.from_bytes(packet[header + 4:header + 6], "big")
                    if 8 <= length <= len(packet) - header:
                        udp = packet[header + 8:header + length]
                protocol = ""
                if udp is not None:
                    if 5353 in ports:
                        protocol = "mdns"
                    elif 5355 in ports:
                        protocol = "llmnr"
                    elif 137 in ports:
                        protocol = "nbns"
                    elif set(ports) == {67, 68}:
                        protocol = "dhcp"
                    elif 53 in ports:
                        protocol = "dns"
                record = observe(ipv4[12:16], source_mac,
                                 "broadcast-or-multicast-ipv4" if broadcast else protocol + "-traffic") if broadcast or protocol else None
                if protocol == "dhcp" and udp is not None:
                    name, requested = dhcp_details(udp)
                    if record is None and requested is not None:
                        record = observe(requested.packed, source_mac, "dhcp-requested-address")
                elif protocol and udp is not None:
                    name = dns_query_name(udp, protocol == "nbns")
                else:
                    name = ""
                if record and protocol:
                    record["protocols"].add(protocol)
                    if name and len(record["names"]) < 16:
                        record["names"].add(name)
    if offset != len(data):
        raise ValueError("Incomplete PCAP tail")
    for record in hosts.values():
        record["signals"] = sorted(record["signals"])
        record["protocols"] = sorted(record["protocols"])
        record["names"] = sorted(record["names"])
    return sorted(hosts.values(), key=lambda record: ipaddress.ip_address(record["address"])), packets


def main():
    if len(sys.argv) != 2:
        raise ValueError("Usage: reconclave-passive IPv4_OR_CIDR")
    scope = ipaddress.ip_network(sys.argv[1], strict=False)
    if scope.version != 4 or scope.prefixlen < 24:
        raise ValueError("Scope must be IPv4 /24 or smaller")
    interface, own_ip = select_interface(scope, os.environ.get("RECONCLAVE_SCAN_INTERFACE", ""))
    evidence = Path(os.environ.get("RECONCLAVE_EVIDENCE_DIR", "/root/reconclave/evidence"))
    os.umask(0o077)
    evidence.mkdir(parents=True, exist_ok=True)
    global active
    print(f"LISTENING PASSIVELY  {interface}  {scope}  up to 45 seconds", flush=True)
    active = subprocess.Popen(["reconclave-capture", interface, "45", "passive"],
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    try:
        output, _ = active.communicate(timeout=55)
    except subprocess.TimeoutExpired:
        active.terminate()
        output, _ = active.communicate(timeout=5)
        raise RuntimeError("Passive capture exceeded its time budget: " + output[-200:])
    finally:
        status = active.returncode
        active = None
    matches = re.findall(r"^(/[^\r\n]+\.pcap)$", output, re.MULTILINE)
    if not matches:
        raise RuntimeError("No completed passive capture: " + output[-200:])
    pcap = Path(matches[-1])
    print(f"SAVED {pcap}", flush=True)
    hosts, packets = read_pcap(pcap, scope, local_addresses() | {own_ip})
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    base = evidence / f"passive-{stamp}-{os.getpid()}"
    report = base.with_suffix(".txt")
    report.write_text("Reconclave passive LAN sample\n" + f"Scope: {scope}\nInterface: {interface}\n" +
                      f"Outcome: {'cancelled' if cancelled else 'complete' if status == 0 else 'partial'}\n" +
                      f"Packets parsed: {packets}\nHosts observed: {len(hosts)}\n" +
                      "Evidence: ARP, local IPv4 traffic and receive-only DNS/mDNS/LLMNR/NBNS/DHCP observations.\n" +
                      "No passive port is marked open; MAC/IP claims are unverified.\n" +
                      "Visibility on ordinary switched Ethernet and managed Wi-Fi is limited.\n\n" +
                      "\n".join(f"{host['address']}  {host['mac']}  {','.join(host['signals'])}  "
                                f"protocols={','.join(host['protocols']) or 'none'}  "
                                f"names={','.join(host['names']) or 'none'}  packets={host['packets']}"
                                for host in hosts) + "\n")
    payload = {"schema": "sightline-passive-hosts/v1", "scope": str(scope), "interface": interface,
               "observed_ms": int(time.time() * 1000), "hosts": hosts, "packets_parsed": packets}
    pending = base.with_suffix(".json.tmp")
    pending.write_text(json.dumps(payload, separators=(",", ":")) + "\n")
    published = base.with_suffix(".json")
    os.replace(pending, published)
    ready_pending = base.with_suffix(".json.ready.tmp")
    ready_pending.write_text("0\n")
    os.replace(ready_pending, base.with_suffix(".json.ready"))
    print(f"SAVED {report}\nSAVED {published}", flush=True)
    print(f"PASSIVE {'CANCELLED' if cancelled else 'COMPLETE'}  {len(hosts)} hosts observed; no ports inferred", flush=True)
    return 130 if cancelled else 0 if status == 0 else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ValueError, RuntimeError, subprocess.CalledProcessError) as exc:
        print(f"Passive sample: {exc}", file=sys.stderr)
        sys.exit(2)
